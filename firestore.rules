rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /menu/{menuId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email != null;
    }

    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.customerUid == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.customerUid == request.auth.uid
            || request.auth.token.email != null);
      allow update: if request.auth != null
        && (resource.data.customerUid == request.auth.uid
            || request.auth.token.email != null);
      allow delete: if request.auth != null && request.auth.token.email != null;
    }

    match /fcmTokens/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

  }
}
